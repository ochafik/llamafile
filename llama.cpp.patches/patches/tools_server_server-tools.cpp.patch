 namespace fs = std::filesystem;
 
+//
+// llamafile path jail (SECURITY)
+//
+// Every path the built-in file tools touch is confined to a root directory:
+// the server's cwd by default, overridable via --tools-root DIR. The root is
+// owned by llamafile (defined in llamafile/args.cpp) and read here across the
+// link boundary, mirroring the multi-agent hooks in server.cpp.
+//
+
+std::string llamafile_tools_root(); // defined in llamafile/args.cpp
+
+// Resolve `in` against the jail root and canonicalize it (normalizing "."/".."
+// and resolving symlinks for the portion of the path that exists). On success
+// returns true with `out` set to the absolute canonical path. On escape or
+// error returns false with a human-readable reason in `err`.
+static bool jail_resolve(const std::string & in, std::string & out, std::string & err) {
+    std::error_code ec;
+    fs::path root = fs::weakly_canonical(fs::path(llamafile_tools_root()), ec);
+    if (ec || root.empty()) {
+        root = fs::path(llamafile_tools_root());
+    }
+
+    fs::path p(in);
+    if (p.is_relative()) {
+        p = root / p;
+    }
+
+    ec.clear();
+    fs::path canon = fs::weakly_canonical(p, ec);
+    if (ec || canon.empty()) {
+        canon = p.lexically_normal();
+    }
+
+    // containment: canon must be root itself or strictly below it
+    const std::string rel = canon.lexically_relative(root).generic_string();
+    const bool inside = !rel.empty()
+                     && rel != ".."
+                     && rel.rfind("../", 0) != 0; // does not start with "../"
+    if (!inside) {
+        err = "path '" + in + "' escapes the tools root (" + root.string() +
+              "). Use a path inside the root, or start the server with --tools-root.";
+        return false;
+    }
+
+    out = canon.string();
+    return true;
+}
